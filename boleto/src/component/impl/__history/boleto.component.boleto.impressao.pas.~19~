unit boleto.component.boleto.impressao;

interface

uses
  System.SysUtils,
  System.Classes,
  boleto.component.interfaces;

type
  TIImpressao = class(TInterfacedObject, IImpressao)
  private
    FComp: IFactoryComponet;
    FNomeArquivo: String;
    FPDFSenha: String;
    FCalcular: Boolean;

    constructor Create(Comp: IFactoryComponet);
  public
    class function New(Comp: IFactoryComponet): IImpressao;

    function PathNomeArquivo(Value: string): IImpressao;
    function CalcularNomeArquivoPDFIndividual(Value: Boolean): IImpressao;
    function PdfSenha(Value: String): IImpressao;
    function GerarHTML: IImpressao;
    function GerarPDF: IImpressao;
    function GerarPDFIndividual(Value: Integer): IImpressao;
    function ImprimirStream(Value: TStream): IImpressao;
    function Imprimir: IImpressao;
  end;

implementation

{ TIImpressao }

function TIImpressao.CalcularNomeArquivoPDFIndividual(
  Value: Boolean): IImpressao;
begin
  Result := Self;
  FCalcular := Value;
  FComp.ACBrBoleto.This.ACBrBoletoFC.CalcularNomeArquivoPDFIndividual := Value;
end;

constructor TIImpressao.Create(Comp: IFactoryComponet);
begin
  FComp := Comp;
end;

function TIImpressao.GerarHTML: IImpressao;
begin
  Result := Self;
  if not FNomeArquivo.IsEmpty then
  begin
    FComp.ACBrBoleto.This.ACBrBoletoFC.NomeArquivo := FNomeArquivo;
    FComp.ACBrBoleto.This.GerarHTML;
    Exit;
  end;
  raise Exception.Create('O nome do arquivo deve ser informado');
end;

function TIImpressao.GerarPDF: IImpressao;
begin
  Result := Self;
  FComp.ACBrBoleto.This.GerarPDF;
end;

function TIImpressao.GerarPDFIndividual(Value: Integer): IImpressao;
begin
  Result := Self;
  for var I := 0 to Pred(FComp.ACBrBoleto.This.ListadeBoletos.Count) do
  begin
    FComp.ACBrBoleto.This.ACBrBoletoFC.CalcularNomeArquivoPDFIndividual := FCalcular;
    FComp.ACBrBoleto.This.ACBrBoletoFC.PdfSenha := FPDFSenha;
    FComp.ACBrBoleto.This.GerarPDF(I);
  end;
end;

function TIImpressao.Imprimir: IImpressao;
begin
  REsult := Self;
  FComp.ACBrBoleto.This.ACBrBoletoFC.PdfSenha := FPDFSenha;
  FComp.ACBrBoleto.This.Imprimir;
end;

function TIImpressao.ImprimirStream(Value: TStream): IImpressao;
begin
  Result := Self;
  if FNomeArquivo.IsEmpty then
    raise Exception.Create('O nome do arquivo deve ser informado');
  var lPath := ExtractFilePath(Application.ExeName) + 'testeStream.pdf';
  InputQuery('Salvando Boleto em Stream','Caminho + Arquivo + Extenção a salvar o Stream',xPath);
  LMeuStream := TFileStream.Create(xPath,fmCreate or fmOpenWrite);
  try
    FACBrBoleto.ACBrBoletoFC.PdfSenha := edtSenhaPDF.Text;
    FACBrBoleto.Imprimir(LMeuStream);
  finally
    LMeuStream.Free;
  end;
end;

class function TIImpressao.New(Comp: IFactoryComponet): IImpressao;
begin
  Result := Self.Create(Comp);
end;

function TIImpressao.PathNomeArquivo(Value: string): IImpressao;
begin
  Result := Self;
  FNomeArquivo := Value;
end;

function TIImpressao.PdfSenha(Value: String): IImpressao;
begin
  Result := Self;
  FPDFSenha := Value;
end;

end.
