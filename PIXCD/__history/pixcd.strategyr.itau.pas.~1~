unit pixcd.strategyr.itau;

interface

uses
  ACBrPIXCD,
  ACBrPIXPSPItau,
  pixcd.interfaces;

type
  TStrategyItaur = class(TInterfacedObject, IStrategy)
  private
    FPSP: TACBrPSPItau;

    constructor Create(Conf: IConfiguracao);
    destructor Destroy; override;
  public
    class function New(Conf: IConfiguracao): IStrategy;

    function PSP: TACBrPSP;
  end;

implementation

{ TStrategyItaur }

constructor TStrategyItaur.Create(Conf: IConfiguracao);
begin
  FPSP := TACBrPSPItau.Create(nil);
end;

destructor TStrategyItaur.Destroy;
begin
  FPSP.Free;
  inherited;
end;

class function TStrategyItaur.New(Conf: IConfiguracao): IStrategy;
begin
  Result := Self.Create(Conf);
end;

function TStrategyItaur.PSP: TACBrPSP;
begin
  Result := FPSP;
end;

end.
