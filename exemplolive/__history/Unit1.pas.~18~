{$R *.fmx}

function TForm1.AddTexto(Value: String): TForm1;
begin
  REsult := SElf;
  Memo1.Lines.Add(Value);
end;

procedure TForm1.Button1Click(Sender: TObject);
begin
  Memo1.Lines.Clear;
  AddTexto('</zera>')
  .AddTexto('</linha_dupla>')
  .AddTexto('</ce><e>Academia do Codigo</e>')
  .AddTexto('www.clubedosprogramadores.com.br')
  .AddTexto('2299999999')
  .AddTexto('</linha_simples>')
  .AddTexto('')
  .AddTexto('')
  .AddTexto('<in><e>CUPOM SEM VALOR FISCAL</e></in></fn>')
  .AddTexto('')
  .AddTexto('')
  .AddTexto('<n>ITENS DA VENDA</n>')
  .AddTexto('</linha_simples>');

  var lTotal := 0.00;

  ClientDataSet1.First;
  while not ClientDataSet1.Eof do
  begin
    AddTexto(ClientDataSet1codigo.AsInteger.ToString+' '+
             ClientDataSet1descricao.AsString+' '+
             FormatCurr(',0.000',ClientDataSet1quantidade.AsCurrency)+' x '+
             FormatCurr('"R$ ",0.00', ClientDataSet1valorunitario.AsCurrency)+' = '+
             FormatCurr('"R$ ",0.00', ClientDataSet1total.AsCurrency));
    lTotal := lTotal + ClientDataSet1total.AsCurrency;
    ClientDataSet1.Next;
  end;
  AddTexto('-------------------------------------------------')
  .AddTexto('Quantidade de itens.: '+ClientDataSet1.FieldCount.ToString)
  .AddTexto('Total.: '+FormatCurr('"R$ ",0.00', lTotal))
  .AddTexto('------------------------------------------------');

  ACBrPosPrinter1.Ativar;
  ACBrPosPrinter1.Buffer.Text := Memo1.Text;
  ACBrPosPrinter1.Imprimir;
end;

